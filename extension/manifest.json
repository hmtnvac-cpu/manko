{
  "manifest_version": 3,
  "name": "Manko Demo Collector",
  "version": "1.6.0",
  "description": "Clean 20-movie Manko demo collector: Vietnamese metadata, multiple streams and one Vietnamese subtitle.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://manko.fun/*",
    "https://javplayer.cc/*",
    "https://healertanker.com/*",
    "https://translate.googleapis.com/*",
    "https://manko-api.onrender.com/*"
  ],
  "background": {
    "service_worker": "service_worker_main.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manko Demo Collector"
  },
  "content_scripts": [
    {
      "matches": ["https://manko.fun/movie-info/*"],
      "js": ["content_manko.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://javplayer.cc/e/*"],
      "js": ["content_javplayer.js"],
      "run_at": "document_idle"
    }
  ]
}
