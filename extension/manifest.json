{
  "manifest_version": 3,
  "name": "Manko Full Collector",
  "version": "3.5.1",
  "description": "Stable result-first Manko collector: every completed movie is posted immediately to the addon backend.",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://manko.fun/*",
    "https://javplayer.cc/*",
    "https://healertanker.com/*",
    "https://translate.googleapis.com/*",
    "https://manko-api.onrender.com/*"
  ],
  "background": {"service_worker": "service_worker_main.js"},
  "action": {"default_popup": "popup.html", "default_title": "Manko Full Collector"},
  "content_scripts": [
    {"matches": ["https://manko.fun/movie-info/*"], "js": ["content_manko.js"], "run_at": "document_idle"},
    {"matches": ["https://javplayer.cc/e/*"], "js": ["content_javplayer.js"], "run_at": "document_idle"}
  ]
}
