{
  "manifest_version": 3,
  "name": "Film4K Collector",
  "version": "4.3.0",
  "description": "Film4K.net collector with explicit HLS/DASH/MP4 link scanning, API capture and runner support.",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://film4k.net/*",
    "https://www.film4k.net/*",
    "https://manko-api.onrender.com/*"
  ],
  "background": {"service_worker": "runner_final.js"},
  "action": {"default_title": "Film4K Collector 4.3.0", "default_popup": "runner_popup.html"},
  "content_scripts": [
    {
      "matches": ["https://film4k.net/*", "https://www.film4k.net/*"],
      "js": ["page_probe_main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://film4k.net/*", "https://www.film4k.net/*"],
      "js": ["content_film4k.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}