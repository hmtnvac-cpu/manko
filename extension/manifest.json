{
  "manifest_version": 3,
  "name": "Film4K Collector",
  "version": "4.1.0",
  "description": "Film4K.net collector for catalog, player and stream discovery.",
  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": [
    "https://film4k.net/*",
    "https://www.film4k.net/*",
    "https://manko-api.onrender.com/*"
  ],
  "background": {"service_worker": "runner_final.js"},
  "action": {"default_title": "Film4K Collector", "default_popup": "runner_popup.html"},
  "content_scripts": [
    {"matches": ["https://film4k.net/*", "https://www.film4k.net/*"], "js": ["content_film4k.js"], "run_at": "document_start"}
  ]
}
